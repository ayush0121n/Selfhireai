{
  "manifest_version": 3,
  "name": "SelfHire.ai — Autonomous Career Agent",
  "version": "1.0.0",
  "description": "Intelligent AI job detection, ATS resume tailoring, and smart application autofill.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://127.0.0.1:8001/*",
    "http://localhost:*/*",
    "https://*.linkedin.com/*",
    "https://*.indeed.com/*",
    "https://*.naukri.com/*",
    "https://*.unstop.com/*",
    "https://*.wellfound.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SelfHire.ai Copilot"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/*", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
